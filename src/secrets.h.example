// Copy this file to src/secrets.h and fill it in. src/secrets.h is gitignored
// and must stay that way -- this repository is public.
#pragma once

#define WIFI_SSID       "your-network"
#define WIFI_PASSWORD   "your-password"

// From https://developer.spotify.com/dashboard -- create an app, then add
// http://127.0.0.1:8888/callback as a Redirect URI. The Client ID is public;
// there is deliberately no client secret here. Auth uses PKCE, so nothing
// secret-shaped has to live in the firmware where it could be read out of
// flash by anyone holding the board.
#define SPOTIFY_CLIENT_ID     "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// Produced by tools/spotify_auth.py -- run it once, paste the result here.
// Only a first-boot seed: Spotify rotates the refresh token on every refresh
// and the firmware saves each new one to NVS, so this value going stale is
// expected and harmless.
#define SPOTIFY_REFRESH_TOKEN "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
